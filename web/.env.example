# Copy to .env.local (ignored by git) and adjust. Every variable is optional;
# unset links (docs, web app) are hidden.

# Backend origin. Unset: same origin in production (proxy /v1/* to the
# backend), http://localhost:8090 in development.
# VITE_API_BASE=https://api.example.com

# Site name shown before the backend's site settings load, and in index.html
# and llms.txt.
# VITE_SITE_NAME=JuCode

# Registered domains this frontend is served from, comma separated. Sibling
# sites such as the docs are resolved under the domain the visitor is on;
# VITE_SITE_DEFAULT_DOMAIN is used when the host matches none of them.
# VITE_SITE_DOMAINS=example.com,example.org
# VITE_SITE_DEFAULT_DOMAIN=example.com

# Documentation site. Unset: https://docs.<current domain>, or no docs link
# when no domain is configured.
# VITE_DOCS_URL=https://docs.example.com

# Hosted web chat app linked from the navbar and footer. Empty hides the link.
# VITE_WEB_APP_URL=https://app.example.com/chat

# Public origin written into llms.txt at build time. Unset: relative links.
# VITE_PUBLIC_SITE_URL=https://example.com
